__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
*.db
.venv/
venv/

# backend/samples/ (real Docusaurus site + real target CLI repo used for end-to-end testing)
backend/samples/docs-site/node_modules/
backend/samples/docs-site/build/
backend/samples/docs-site/.docusaurus/
backend/samples/docs-site/mcp-server.log

# backend/samples/target-cli is its own git repo, already pushed independently to
# github.com/luishpcosta/ai-lup-poc-target-cli — not tracked as regular files here.
backend/samples/target-cli/

# Real clones the plugins create at runtime (workspace_setup) — always regenerable
# from repo_url + historia_id, never source.
backend/workspaces/

# Per-run/per-batch SQLite state stores (ADR-001/ADR-003) — generated at runtime.
backend/run-many-state/

# Ad-hoc session logs from manual `workflow run`/`run-many` invocations during
# development (redirected stdout) — not source, not curated evidence.
/backend/run-*.log

# Logs de ./start-local.sh (backend/frontend rodando localmente).
/.local-logs/

# Symlink local para .agents/skills/ui-craft/ (conteudo real, versionado).
# core.symlinks=false neste ambiente faz o git desreferenciar e duplicar todo
# o conteudo se este caminho for adicionado — o instalador da skill recria o
# link sozinho quando necessario.
/.claude/skills/ui-craft
